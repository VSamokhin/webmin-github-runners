# Repositories whose (repository-level) self-hosted runners and queued jobs to show.
GHR_REPOS=octo-user/app-one,octo-user/app-two
# Organizations whose org-level runners to show (optional).
GHR_ORGS=
# Fine-grained token, read-only: "Administration: Read" and "Actions: Read"
# on the repositories above (org runners: "Self-hosted runners: Read" on the org).
GHR_GITHUB_TOKEN=github_pat_xxx
# Seconds between polls.
GHR_INTERVAL=60
# Only show containers whose name matches this regex (empty = all).
GHR_DOCKER_FILTER=runner
# label=path pairs for free disk space, paths as seen by the collector.
GHR_DISKS=root=/host/root
